# Copie para .env e ajuste os valores

# Asaas (sandbox: https://sandbox.asaas.com/)
ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_ACCESS_TOKEN=
BILLING_BLOCK_AFTER_DAYS=15
BILLING_ENFORCE_BLOCKS=True

# Desenvolvimento local com Docker Compose (serviço web lê este arquivo via env_file)
# Host db:5432 = rede interna do Compose. Do Mac (psql/DBeaver): localhost:5433
DATABASE_URL=postgres://agendamento_user:agendamento_pass@db:5432/agendamento

# Produção (Supabase)
# DATABASE_URL=postgres://postgres:[senha]@db.[ref].supabase.co:5432/postgres

SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# E-mail (dev: console; produção: SMTP)
